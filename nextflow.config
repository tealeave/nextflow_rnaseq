// --- Global Parameters ---
params {
    // Input/Output
    samplesheet_file = 'samplesheet.csv'
    outdir           = 'results'
    // NEW: Add work_dir parameter. Defaults to 'work' in the launch directory.
    // This allows you to override it from the command line with -w
    work_dir         = 'work'

    // Reference Files
    genome_fasta = 'genomes/hg38.fa'
    genome_gtf   = 'genomes/hg38.gtf'

    // --- Workflow Control ---
    // REMOVED: qc_only and trim_only are no longer used.
    // qc_only = false
    // trim_only = false
    
    // NEW: Add the 'step' parameter for flexible execution.
    // Options: 'qc_raw', 'trim', 'align', 'full'
    step = 'full'

    // Default trimming parameters if 'trim_args' is not in samplesheet
    trim_args_default = '--quality 20 --clip_R1 5 --clip_R2 5 --length 20 --trim-n'
}

// Set the work directory from the parameter
workDir = params.work_dir

// --- Process Configuration ---
process {
    executor = 'slurm'
    cpus = 2
    memory = '8.GB'
    time = '4h'

    // FIXED: Use regex to match both FASTQC_RAW and FASTQC_TRIM
    withName: /FASTQC_.*/ {
        module = 'fastqc/0.11.9'
        beforeScript = 'module load fastqc/0.11.9'
    }

    withName: /TRIM_GALORE_.*/ { // This is correct
        module = 'trimgalore/0.6.7'
        beforeScript = 'module unload fastqc/0.11.9; module load trimgalore/0.6.7'
        cpus = 4
        memory = '16.GB'
    }

    withName: TRIM_GALORE_PE { // This is correct and a good practice
        memory = '32.GB'
        time = '6h'
    }

    withName: HISAT2_INDEX { // This is correct
        module = 'hisat2/2.2.1'
        beforeScript = 'module unload fastqc/0.11.9; module load hisat2/2.2.1'
        cpus = 8
        memory = '48.GB'
    }

    withName: HISAT2_ALIGN { // This is correct
        beforeScript = 'module unload trimgalore/0.6.7; module load hisat2/2.2.1 samtools/1.15.1'
        label = 'high_mem'
        cpus = 8
        memory = '48.GB'
        time = '12h'
    }

    withName: /FEATURE_COUNTS_.*/ { // This is correct
        module = 'subread/2.0.3'
        beforeScript = 'module unload hisat2/2.2.1; module unload samtools/1.15.1; module load subread/2.0.3'
        cpus = 8
        time = '12h'
    }
    
    // UPDATED: Removed MULTIQC from this general group
    withName: 'CAT_SE_READS|MERGE_COUNTS' {
        module = 'python/3.10.2'
    }
    
    // NEW: Added a specific block just for MULTIQC
    withName: MULTIQC {
        // Unload the previous step's module, then activate the specific poetry venv
        module = 'python/3.10.2'
        beforeScript = '''
        module unload subread/2.0.3
        source /data/homezvol2/ddlin/.cache/pypoetry/virtualenvs/nextflow-rnaseq-4UrPdjYw-py3.10/bin/activate
        '''
    }
}

// --- Execution Profiles ---
profiles {
    standard {
        process.executor = 'local'
    }
    hpc {
        process.executor = 'slurm'
    }
}